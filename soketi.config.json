{
    "port": 6001,
    "appManager": "array",
    "apps": [
        {
            "id": "pharaon-local",
            "key": "pharaon-local-key",
            "secret": "pharaon-local-secret",
            "enable_client_messages": false,
            "enable_statistics": true
        }
    ],
    "sockets": {
        "host": "0.0.0.0",
        "port": 6001
    },
    "cors": {
        "origin": ["http://localhost:8000", "http://127.0.0.1:8000", "http://localhost:5173", "http://127.0.0.1:5173"],
        "methods": ["GET", "POST"],
        "headers": true,
        "credentials": true
    }
}
