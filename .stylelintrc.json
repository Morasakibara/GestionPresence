{
    "extends": "stylelint-config-standard",
    "rules": {
      "selector-max-id": 0,  
    "declaration-block-trailing-semicolon": null,  
    "no-descending-specificity": null,
        "at-rule-no-unknown": [
        true,
        {
          "ignoreAtRules": ["tailwind", "apply", "variants", "responsive", "screen"]
        }
      ],
      "block-no-empty": null,
      "unit-whitelist": ["em", "rem", "%", "s"]
    }
  }
  